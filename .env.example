# Supabase (project "My own") — login-ka WhatsApp + sheekooyinka halkan ayay ku kaydsan yihiin
SUPABASE_URL=https://zunodiphwtydetxhlemo.supabase.co
# Supabase → Project Settings → API Keys → "service_role" / secret key  (HA LA WADAAGIN)
SUPABASE_SERVICE_KEY=

# Google Sheet (Apps Script Web App URL — /exec ku dhammaada)
SHEET_WEBAPP_URL=
SHEET_SECRET=beddel-sirtan-123

TZ_NAME=Africa/Addis_Ababa

