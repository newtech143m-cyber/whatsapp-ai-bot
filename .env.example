AI_API_KEY=
# Ikhtiyaari — model kale haddii aad rabto (default: gemini-2.5-flash)
# AI_MODEL=gemini-2.5-flash

# Password-ka dashboard-ka (ugu yaraan 6 xaraf — dashboard-ku waa online!)
